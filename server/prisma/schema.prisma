
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}




model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  posts     Post[]
  portfolios Portfolio[]
}

model Post {
  id          Int      @id @default(autoincrement())
  description String
  image       String?
  createdAt   DateTime @default(now())

  userId Int
  user   User   @relation(fields: [userId], references: [id])
}

model Portfolio {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])
}

