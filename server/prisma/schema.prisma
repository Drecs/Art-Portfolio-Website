
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}




model User {
  id        Int      @id @default(autoincrement())
  username  String   
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  posts     Post[]
  portfolios Portfolio[]
}

model Post {
  id          Int      @id @default(autoincrement())
  description String
  image       String?
  createdAt   DateTime @default(now())

  userId Int
  user   User   @relation(fields: [userId], references: [id])
}

model Portfolio {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  profilePic  String?   //  store image URL/path
  createdAt   DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  samples PortfolioImage[]  //  relation for multiple images
}

model PortfolioImage {
  id          Int      @id @default(autoincrement())
  imageUrl    String

  portfolioId Int
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
}

